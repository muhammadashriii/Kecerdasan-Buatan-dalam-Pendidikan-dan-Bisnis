<!-- =====================================================
     MATERI
===================================================== -->

<section class="section" id="materi">

    <div class="container">

        <div class="section-heading">

            <span class="section-label">
                Materi Pembelajaran
            </span>

            <h2>
                Kumpulan Materi
            </h2>

            <p>
                Pilih materi pembelajaran yang ingin dipelajari.
            </p>

        </div>


        <!-- SEARCH -->

        <div class="search-wrapper">

            <input
                type="text"
                id="searchInput"
                placeholder="Cari materi, modul, atau LKPD..."
                onkeyup="searchContent()">

            <i class="fa-solid fa-magnifying-glass"></i>

        </div>


        <div class="feature-grid" id="contentGrid">


            <!-- MATERI 1 -->

            <div class="feature-card searchable"
                 data-title="persamaan dasar akuntansi">

                <div class="icon-box blue">

                    <i class="fa-solid fa-calculator"></i>

                </div>

                <h3>
                    Persamaan Dasar Akuntansi
                </h3>

                <p>
                    Memahami konsep dasar persamaan
                    akuntansi dan hubungan antara aset,
                    liabilitas, dan ekuitas.
                </p>

                <button
                    class="btn btn-primary"
                    onclick="showNotification('Materi Persamaan Dasar Akuntansi dibuka')">

                    <i class="fa-solid fa-book-open"></i>

                    Pelajari

                </button>

            </div>


            <!-- MATERI 2 -->

            <div class="feature-card searchable"
                 data-title="jurnal umum">

                <div class="icon-box purple">

                    <i class="fa-solid fa-file-invoice-dollar"></i>

                </div>

                <h3>
                    Jurnal Umum
                </h3>

                <p>
                    Materi mengenai konsep dan pencatatan
                    transaksi ke dalam jurnal umum.
                </p>

                <button
                    class="btn btn-primary"
                    onclick="showNotification('Materi Jurnal Umum dibuka')">

