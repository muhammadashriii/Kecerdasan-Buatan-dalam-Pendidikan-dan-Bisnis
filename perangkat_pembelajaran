<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ruang Belajar Guru</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        /* =====================================================
           RESET & DASAR
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --secondary: #7c3aed;

            --dark: #172033;
            --text: #526071;
            --muted: #8b95a7;

            --light: #f5f8ff;
            --white: #ffffff;

            --border: #e5eaf2;

            --shadow:
                0 15px 40px rgba(37, 99, 235, 0.08);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            color: var(--dark);
            background: #ffffff;
            line-height: 1.7;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        .container {
            width: min(1120px, 90%);
            margin: auto;
        }


        /* =====================================================
           NAVBAR
        ===================================================== */

        .navbar {
            height: 75px;
            display: flex;
            align-items: center;

            background: rgba(255,255,255,.96);

            border-bottom: 1px solid var(--border);

            position: sticky;
            top: 0;
            z-index: 1000;

            backdrop-filter: blur(10px);
        }

        .nav-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 21px;
            font-weight: 800;
        }

        .logo i {
            color: var(--primary);
            font-size: 25px;
        }

        .logo span span {
            color: var(--primary);
        }

        nav {
            display: flex;
            align-items: center;
            gap: 27px;
        }

        nav a {
            font-size: 14px;
            font-weight: 600;
            color: #657084;

            transition: .3s;
        }

        nav a:hover,
        nav a.active {
            color: var(--primary);
        }

        .menu-toggle {
            display: none;

            border: none;
            background: none;

            font-size: 23px;
            color: var(--dark);

            cursor: pointer;
        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            background:
                linear-gradient(
                    135deg,
                    #f5f8ff,
                    #ffffff
                );

            padding: 90px 0;
        }

        .hero-container {
            display: grid;
            grid-template-columns: 1.1fr .9fr;

            align-items: center;

            gap: 70px;
        }

        .badge,
        .section-label {
            display: inline-block;

            padding: 7px 13px;

            background: #eaf1ff;

            color: var(--primary);

            border-radius: 30px;

            font-size: 12px;
            font-weight: 700;
        }

        .hero h1 {
            font-size: clamp(40px, 5vw, 62px);

            line-height: 1.15;

            margin: 20px 0;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero p {
            max-width: 600px;

            color: var(--text);

            font-size: 16px;

            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 12px;

            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            gap: 9px;

            padding: 13px 20px;

            border-radius: 9px;

            font-size: 14px;
            font-weight: 700;

            border: none;

            cursor: pointer;

            transition: .3s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-outline {
            border: 1px solid var(--border);
            color: var(--dark);
            background: white;
        }

        .btn-outline:hover {
            border-color: var(--primary);
            color: var(--primary);
        }


        /* =====================================================
           HERO ILLUSTRATION
        ===================================================== */

        .hero-image {
            height: 400px;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .teacher-circle {
            width: 280px;
            height: 280px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #dbeafe,
                    #eff6ff
                );

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--primary);

            font-size: 100px;

            box-shadow: var(--shadow);
        }

        .floating-card {
            position: absolute;

            background: white;

            padding: 15px 20px;

            border-radius: 12px;

            box-shadow:
                0 15px 40px rgba(0,0,0,.1);

            display: flex;

            gap: 12px;

            align-items: center;

            animation: floating 3s ease-in-out infinite;
        }

        .floating-card i {
            font-size: 25px;
            color: var(--primary);
        }

        .floating-card small {
            display: block;
            color: #8993a5;
        }

        .card-one {
            top: 40px;
            left: 10px;
        }

        .card-two {
            right: 0;
            bottom: 50px;

            animation-delay: 1s;
        }

        @keyframes floating {

            0%,100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }

        }


        /* =====================================================
           SECTION
        ===================================================== */

        .section {
            padding: 90px 0;
        }

        .section-heading {
            text-align: center;

            max-width: 650px;

            margin: 0 auto 50px;
        }

        .section-heading h2,
        .teacher-info h2 {
            font-size: 36px;

            line-height: 1.25;

            margin: 12px 0;
        }

        .section-heading p {
            color: var(--text);
        }


        /* =====================================================
           FEATURE CARDS
        ===================================================== */

        .feature-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;
        }

        .feature-card {
            padding: 28px;

            border: 1px solid var(--border);

            border-radius: 15px;

            transition: .3s;

            background: white;

            cursor: pointer;
        }

        .feature-card:hover {
            transform: translateY(-7px);

            box-shadow: var(--shadow);

            border-color: #cddcff;
        }

        .icon-box {
            width: 55px;
            height: 55px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 12px;

            font-size: 22px;

            margin-bottom: 20px;
        }

        .blue {
            background: #eaf1ff;
            color: #2563eb;
        }

        .purple {
            background: #f0eaff;
            color: #7c3aed;
        }

        .orange {
            background: #fff1df;
            color: #ea580c;
        }

        .red {
            background: #ffe7e7;
            color: #dc2626;
        }

        .green {
            background: #e7f8ef;
            color: #16a34a;
        }

        .feature-card h3 {
            margin-bottom: 10px;
            font-size: 17px;
        }

        .feature-card p {
            font-size: 13px;
            color: var(--text);

            margin-bottom: 20px;
        }

        .read-more {
            font-size: 12px;

            color: var(--primary);

            font-weight: 700;
        }


        /* =====================================================
           SEARCH
        ===================================================== */

        .search-wrapper {
            max-width: 600px;
            margin: 0 auto 45px;

            position: relative;
        }

        .search-wrapper input {
            width: 100%;

            padding: 16px 50px 16px 20px;

            border: 1px solid var(--border);

            border-radius: 12px;

            outline: none;

            font-family: inherit;
            font-size: 14px;

            transition: .3s;
        }

        .search-wrapper input:focus {
            border-color: var(--primary);

            box-shadow:
                0 0 0 4px rgba(37,99,235,.08);
        }

        .search-wrapper i {
            position: absolute;

            right: 20px;
            top: 50%;

            transform: translateY(-50%);

            color: var(--muted);
        }


        /* =====================================================
           RESOURCE CARDS
        ===================================================== */

        .resource-section {
            display: none;
        }

        .resource-section.show {
            display: block;
        }

        .resource-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;
        }

        .resource-card {
            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 25px;

            background: white;

            transition: .3s;
        }

        .resource-card:hover {
            transform: translateY(-5px);

            box-shadow: var(--shadow);
        }

        .resource-card .resource-icon {
            width: 50px;
            height: 50px;

            border-radius: 10px;

            display: flex;

            align-items: center;
            justify-content: center;

            margin-bottom: 18px;

            font-size: 20px;
        }

        .resource-card h3 {
            font-size: 16px;

            margin-bottom: 8px;
        }

        .resource-card p {
            color: var(--text);

            font-size: 13px;

            margin-bottom: 18px;
        }


        /* =====================================================
           TEACHER
        ===================================================== */

        .teacher-section {
            padding: 90px 0;

            background: var(--light);
        }

        .teacher-container {
            display: grid;

            grid-template-columns:
                .8fr 1.2fr;

            align-items: center;

            gap: 70px;
        }

        .teacher-photo {
            display: flex;
            justify-content: center;
        }

        .photo-placeholder {
            width: 280px;
            height: 340px;

            border-radius: 25px;

            background:
                linear-gradient(
                    135deg,
                    #dbeafe,
                    #eff6ff
                );

            display: flex;

            justify-content: center;
            align-items: center;

            font-size: 90px;

            color: var(--primary);

            box-shadow: var(--shadow);
        }

        .teacher-info p {
            color: var(--text);

            margin-bottom: 15px;
        }

        .teacher-details {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 15px;

            margin: 25px 0;
        }

        .detail-box {
            padding: 15px;

            border-radius: 10px;

            background: white;

            border: 1px solid var(--border);
        }

        .detail-box strong {
            display: block;

            font-size: 12px;

            color: var(--muted);

            margin-bottom: 3px;
        }

        .detail-box span {
            font-weight: 600;

            font-size: 14px;
        }


        /* =====================================================
           VIDEO
        ===================================================== */

        .video-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 30px;
        }

        .video-card {
            border: 1px solid var(--border);

            border-radius: 15px;

            overflow: hidden;

            background: white;

            transition: .3s;
        }

        .video-card:hover {
            transform: translateY(-5px);

            box-shadow: var(--shadow);
        }

        .video-container {
            position: relative;

            padding-bottom: 56.25%;

            height: 0;
        }

        .video-container iframe {
            position: absolute;

            width: 100%;
            height: 100%;

            border: 0;
        }

        .video-content {
            padding: 20px;
        }

        .video-content h3 {
            margin-bottom: 8px;
        }

        .video-content p {
            color: var(--text);

            font-size: 14px;
        }


        /* =====================================================
           STATISTICS
        ===================================================== */

        .stats-section {
            padding: 60px 0;

            background: var(--primary);

            color: white;
        }

        .stats-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            text-align: center;
        }

        .stat {
            display: flex;

            flex-direction: column;

            align-items: center;

            gap: 3px;
        }

        .stat i {
            font-size: 24px;

            margin-bottom: 5px;
        }

        .stat strong {
            font-size: 30px;
        }

        .stat span {
            opacity: .8;

            font-size: 13px;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            background: #111827;

            color: white;

            padding-top: 60px;
        }

        .footer-container {
            display: grid;

            grid-template-columns:
                2fr 1fr 1fr;

            gap: 60px;

            padding-bottom: 50px;
        }

        .footer-logo {
            margin-bottom: 15px;
        }

        .footer-container p {
            color: #9ca3af;

            font-size: 13px;

            max-width: 400px;
        }

        .footer-links {
            display: flex;

            flex-direction: column;

            gap: 8px;
        }

        .footer-links h4 {
            margin-bottom: 10px;
        }

        .footer-links a,
        .footer-links p {
            color: #9ca3af;

            font-size: 13px;
        }

        .footer-links a:hover {
            color: white;
        }

        .copyright {
            border-top: 1px solid #283142;

            text-align: center;

            padding: 20px;

            color: #8b95a7;

            font-size: 12px;
        }


        /* =====================================================
           NOTIFICATION
        ===================================================== */

        .notification {
            position: fixed;

            bottom: 25px;
            right: 25px;

            background: #172033;

            color: white;

            padding: 14px 20px;

            border-radius: 10px;

            box-shadow:
                0 10px 30px rgba(0,0,0,.2);

            font-size: 13px;

            transform:
                translateY(100px);

            opacity: 0;

            transition: .3s;

            z-index: 2000;
        }

        .notification.show {
            transform: translateY(0);
            opacity: 1;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media(max-width: 950px) {

            nav {
                position: absolute;

                top: 75px;
                left: 0;

                width: 100%;

                background: white;

                flex-direction: column;

                padding: 25px;

                display: none;

                box-shadow:
                    0 15px 30px rgba(0,0,0,.08);
            }

            nav.show {
                display: flex;
            }

            .menu-toggle {
                display: block;
            }

            .hero-container {
                grid-template-columns: 1fr;

                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .feature-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .teacher-container {
                grid-template-columns: 1fr;

                text-align: center;
            }

            .teacher-photo {
                order: 2;
            }

            .teacher-info {
                order: 1;
            }

            .stats-grid {
                grid-template-columns:
                    repeat(2, 1fr);

                gap: 30px;
            }

            .footer-container {
                grid-template-columns:
                    1fr 1fr;
            }

            .resource-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }
        }


        @media(max-width: 650px) {

            .hero {
                padding: 60px 0;
            }

            .hero-image {
                height: 300px;
            }

            .teacher-circle {
                width: 210px;
                height: 210px;

                font-size: 70px;
            }

            .floating-card {
                transform: scale(.8);
            }

            .feature-grid,
            .resource-grid,
            .video-grid {
                grid-template-columns: 1fr;
            }

            .footer-container {
                grid-template-columns: 1fr;
            }

            .section-heading h2,
            .teacher-info h2 {
                font-size: 28px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .teacher-details {
                grid-template-columns: 1fr;
            }

        }

    </style>
</head>


